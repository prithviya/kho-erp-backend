APP_NAME=ERP Backend
NODE_ENV=production
PORT=3000

FRONTEND_URL=https://will.khosocial.com
BACKEND_URL=https://will.khosocial.com
PASSWORD_RESET_URL=https://will.khosocial.com/reset-password

DB_TYPE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_AUTO_SYNC=true
DB_SYNC_ALTER=false
ENABLE_SQL_LOG=false

JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
SUPER_ADMIN_EMAIL=your-admin-email@example.com
SUPER_ADMIN_INITIAL_PASSWORD=

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
