APP_NAME=ERP Backend

FRONTEND_URL=http://localhost:5173

PORT=5000
NODE_ENV=development

# mysql 
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3308
DB_NAME=erp_db
DB_USER=root
DB_PASSWORD=

# PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=erp_db
# DB_USER=postgres
# DB_PASSWORD=1234
# DB_TYPE=postgres

# Enable SQL logging for debugging purposes
ENABLE_SQL_LOG=true

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# JWT and Cookie Security
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Password reset delivery
PASSWORD_RESET_URL=http://localhost:5173/reset-password